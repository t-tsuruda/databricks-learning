// Prisma schema for the Databricks Learning Platform.
//
// Production uses PostgreSQL (deployed on Vercel with Vercel Postgres /
// Neon). DATABASE_URL is the pooled connection (used by the app at
// runtime) and DATABASE_URL_UNPOOLED is the direct connection (used by
// Prisma Migrate, which cannot run through a pgbouncer-style pooler). Both
// are injected automatically when a Postgres storage integration is
// attached to the Vercel project — see README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum LessonType {
  TEXT
  EXERCISE
  QUIZ
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  displayName     String
  isAdmin         Boolean  @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courseProgress      UserCourseProgress[]
  lessonProgress      UserLessonProgress[]
  quizAnswers         QuizAnswer[]
  passwordResetTokens PasswordResetToken[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  missionText String // ARCS Attention/Relevance copy shown at course entry
  closingColumn String @default("") // 修了時のモチベーションコラム（学習者向け, Satisfaction）
  level       Int // 1-4, matches curriculum level
  orderIndex  Int
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons  Lesson[]
  progress UserCourseProgress[]

  @@index([level, orderIndex])
}

model Lesson {
  id         String     @id @default(cuid())
  courseId   String
  slug       String
  title      String
  questTitle String @default("") // 挑戦心を煽るクエストタイトル（大見出し、22-1）。titleは「何を学ぶか」のサブタイトルとして表示
  type       LessonType @default(TEXT)
  orderIndex Int

  // ARCS-aligned module structure (see docs/prd.md section 4, 19-2)
  attentionText  String // 注意喚起：学習者の興味を引く導入 (ARCS Attention)
  relevanceText  String // 関連性：学習者自身のゴールとの繋がり (ARCS Relevance)
  lectureContent String // 座学：概念説明 (markdown)
  exampleContent String // 具体例
  handsOnContent String // ハンズオン手順 (Databricks操作)
  modelAnswerContent String @default("") // ハンズオンの模範解答（折りたたみ表示, 20-2）
  outcomesJson   String // これでできるようになったこと（JSON配列, 1-3件）
  relatedJobs    String // このスキルが使われる仕事 (カンマ区切りキーワード)
  referenceLinksJson String @default("[]") // 参考リンク（JSON配列, {label,url}[]）
  skillTagsJson String @default("[]") // 身につくスキルキーワード（JSON配列, 21-1）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress UserLessonProgress[]
  quizzes  Quiz[]

  @@unique([courseId, slug])
  @@index([courseId, orderIndex])
}

model UserCourseProgress {
  id               String         @id @default(cuid())
  userId           String
  courseId         String
  status           ProgressStatus @default(NOT_STARTED)
  progressPercent  Int            @default(0)
  completedAt      DateTime?
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model UserLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  score       Int?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Quiz {
  id         String @id @default(cuid())
  lessonId   String
  question   String
  orderIndex Int

  lesson  Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([lessonId, orderIndex])
}

model QuizOption {
  id         String  @id @default(cuid())
  quizId     String
  label      String
  isCorrect  Boolean @default(false)
  orderIndex Int

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

model QuizAnswer {
  id               String   @id @default(cuid())
  userId           String
  quizId           String
  selectedOptionId String
  isCorrect        Boolean
  submittedAt      DateTime @default(now())

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  selectedOption QuizOption @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
}

// Simple key-value store for admin-controlled settings, e.g. whether
// signup is open, and the motivational message pool (docs/prd.md section 3).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
